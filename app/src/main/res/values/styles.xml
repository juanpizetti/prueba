<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AboutCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="AboutCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="AboutTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AboutText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">#2B2F3A</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
